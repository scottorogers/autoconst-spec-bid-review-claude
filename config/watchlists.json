{
  "_readme": "Price-impacting requirements estimators scan specs for. Boilerplate (ACI, aggregate, psi...) is deliberately excluded. 'match' is a case-insensitive regex; a literal space matches space OR hyphen (so 'epoxy coated' also finds 'epoxy-coated'); write an optional separator as (?: )?. Never put a space inside [brackets]. Add items per client scope.",
  "concrete": [
    {
      "item": "Epoxy-coated reinforcing",
      "match": "epoxy coated (?:reinforc\\w*|rebar|bars?|steel)",
      "why": "premium over uncoated bar; coating touch-up and handling"
    },
    {
      "item": "Galvanized reinforcing",
      "match": "galvanized (?:reinforc\\w*|rebar|bars?)",
      "why": "premium over uncoated bar"
    },
    {
      "item": "Post-tensioning",
      "match": "post tension\\w*",
      "why": "specialty subcontractor, stressing, engineering"
    },
    {
      "item": "Architectural / exposed finish",
      "match": "architectural (?:concrete|finish\\w*)|exposed concrete (?:finish|surfaces?)|form liners?",
      "why": "premium formwork and finishing labor"
    },
    {
      "item": "Sandblast / bush-hammer / exposed aggregate",
      "match": "sand(?: )?blast\\w*|bush hammer\\w*|exposed aggregate",
      "why": "extra surface-finishing labor"
    },
    {
      "item": "Mock-up",
      "match": "mock(?: )?ups?",
      "why": "mock-up panel material, labor and schedule"
    },
    {
      "item": "Waterstops",
      "match": "water(?: )?stops?",
      "why": "material and labor at every joint"
    },
    {
      "item": "Vapor retarder / barrier",
      "match": "vapou?r (?:retarder|barrier)s?",
      "why": "material and labor under slabs"
    },
    {
      "item": "Corrosion inhibitor",
      "match": "corrosion inhibit\\w* (?:admixture|in concrete)|calcium nitrite",
      "why": "admixture premium"
    },
    {
      "item": "Silica fume",
      "match": "silica fume|microsilica",
      "why": "admixture premium, harder finishing"
    },
    {
      "item": "High-early strength",
      "match": "high early (?:strength )?(?:concrete|cement|mix\\w*)",
      "why": "mix premium"
    },
    {
      "item": "Lightweight concrete",
      "match": "light(?: )?weight concrete",
      "why": "mix premium, pumping"
    },
    {
      "item": "Hot / cold weather concreting",
      "match": "hot weather (?:concret\\w*|plan|placement)|cold weather (?:concret\\w*|protection|plan|placement)",
      "why": "protection, heating/cooling, plan submittal"
    },
    {
      "item": "Mass concrete / thermal control",
      "match": "mass concrete|thermal control|temperature monitoring",
      "why": "special mix, sensors, monitoring"
    },
    {
      "item": "Extended wet curing",
      "match": "(?:wet|moist) cur(?:e|ing)|curing blankets?|\\d+ days? (?:of )?(?:wet|moist) cur",
      "why": "curing labor and materials"
    },
    {
      "item": "Floor flatness (FF/FL)",
      "match": "F[FL] ?\\d{2}|FF/FL|flatness",
      "why": "tighter tolerance, laser screed, extra finishing"
    },
    {
      "item": "Densifier / sealer",
      "match": "densifier|(?:concrete|floor|penetrating) seal(?:er|ant)s?",
      "why": "floor treatment material and labor"
    },
    {
      "item": "Non-shrink grout",
      "match": "non shrink grout",
      "why": "material premium"
    },
    {
      "item": "Mechanical splices",
      "match": "mechanical (?:bar )?splices?|couplers?",
      "why": "splice hardware vs lap splices"
    },
    {
      "item": "Fiber reinforcement",
      "match": "fiber reinforc\\w*|(?:synthetic|steel|macro synthetic|polypropylene) fibers?",
      "why": "mix premium"
    },
    {
      "item": "Superplasticizer",
      "match": "superplasticizer|high range water reduc\\w*",
      "why": "admixture and dosing plan"
    },
    {
      "item": "Tremie / underwater placement",
      "match": "tremie|underwater (?:placement|concrete)",
      "why": "specialty placement"
    },
    {
      "item": "Shotcrete",
      "match": "shotcrete",
      "why": "specialty placement"
    }
  ],
  "mep": [
