    },
    {
      "item": "Slab scanning / X-ray",
      "match": "x ray (?:the |of )?(?:slab|concrete|floor|deck)|(?:slab|concrete|deck) (?:x ray|scan\\w*)|ground penetrating radar|\\bGPR\\b|scan\\w* (?:of )?(?:the )?(?:slab|concrete)",
      "why": "pre-core scanning service"
    },
    {
      "item": "Firestopping",
      "match": "firestop\\w*|penetration seals?",
